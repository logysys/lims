# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgrestrusource
DB_PASSWORD=postgrestrusource
DB_DATABASE=trusource_postgres
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# MFA
MFA_APP_NAME=TruSource LIMS

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@trusource.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@trusource.com

# Redis (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Application URLs
LAB_CONSOLE_URL=http://localhost:3001
CUSTOMER_PORTAL_URL=http://localhost:3002
MANUFACTURER_URL=http://localhost:3003
CONSUMER_PORTAL_URL=http://localhost:3004
